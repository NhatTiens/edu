# Homepage CMS requires Supabase. No mock fallback for homepage/search/CMS.
APP_DATA_MODE=supabase
NEXT_PUBLIC_SUPABASE_URL=
# Use the publishable key for new Supabase projects; anon is supported for legacy projects.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Required by trusted quiz transaction services; never expose or commit it.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# Required for public quiz identity cookies/digests. Generate a random value >=32 characters.
# Never prefix this variable with NEXT_PUBLIC_. Keep stable across deployments.
QUIZ_SESSION_SECRET=
