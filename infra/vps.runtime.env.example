# Copy to infra/.env.vps.runtime. Must match build values exactly.
NEXT_PUBLIC_SUPABASE_URL=https://supabase.example.com
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://edu.example.com
# Replace with the verified gateway DNS name and container port on the shared network.
SUPABASE_INTERNAL_URL=http://replace-with-gateway:8000
SUPABASE_SERVICE_ROLE_KEY=
# Preserve the existing secret when migrating an existing database.
QUIZ_SESSION_SECRET=
