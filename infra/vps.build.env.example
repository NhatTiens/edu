# Copy to infra/.env.vps.compose and fill with real public configuration.
# No service key/session secret belongs here. Rebuild when any NEXT_PUBLIC_* changes.
NEXT_PUBLIC_SUPABASE_URL=https://supabase.example.com
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://edu.example.com
EDU_IMAGE_TAG=replace-with-release-tag
EDU_HTTP_PORT=3000
SUPABASE_DOCKER_NETWORK=replace-with-existing-network
