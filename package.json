{
  "name": "eduquiz-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "test:smoke": "node scripts/smoke.mjs",
    "test:cms-browser": "node scripts/cms-browser.mjs",
    "test:quiz-builder": "node --import tsx scripts/quiz-builder-browser.mjs",
    "test:public-quiz": "node --import tsx scripts/public-quiz-browser.mjs",
    "test:result-builder": "node --import tsx scripts/result-builder-browser.mjs",
    "test:final-qa": "node --import tsx scripts/final-qa.mjs",
    "test:e2e": "npm run test:final-qa && npm run test:cms-browser && npm run test:quiz-builder && npm run test:public-quiz && npm run test:result-builder && npm run test:smoke"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.49.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
